{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "pain.001.001.09 Payment Data Schema",
  "description": "Schema for ISO 20022 pain.001.001.09 Customer Credit Transfer Initiation",
  "version": "0.0.48",
  "type": "object",
  "required": [
    "id",
    "date",
    "initiator_name",
    "requested_execution_date",
    "debtor_name",
    "debtor_account_IBAN",
    "debtor_agent_BIC",
    "payment_id",
    "payment_amount",
    "currency",
    "creditor_agent_BIC",
    "creditor_name",
    "creditor_account_IBAN"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 35,
      "pattern": "^[A-Za-z0-9\\-?:().,'+/\\s]*$",
      "description": "Message identification"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Date/time of the payment initiation. Accepts 'YYYY-MM-DD' (rendered as midnight) or a full ISO datetime 'YYYY-MM-DDTHH:MM:SS'."
    },
    "nb_of_txs": {
      "type": "integer",
      "minimum": 1,
      "description": "Number of transactions. Computed automatically from the record count; you may omit it."
    },
    "ctrl_sum": {
      "type": "number",
      "minimum": 0.01,
      "maximum": 999999999.99,
      "description": "Total control sum. Computed automatically from the payment amounts; you may omit it."
    },
    "initiator_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 70,
      "description": "Initiator name"
    },
    "payment_information_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 35,
      "pattern": "^[A-Za-z0-9\\-?:().,'+/\\s]*$",
      "description": "Payment information block identifier; optional for this version (payment_id is used for PmtInfId)."
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "TRF",
        "DD"
      ],
      "description": "Payment method; optional, defaults to 'TRF'."
    },
    "batch_booking": {
      "type": "boolean",
      "description": "Batch booking indicator; JSON true/false (string 'true'/'false' also accepted)."
    },
    "service_level_code": {
      "type": "string",
      "enum": [
        "SEPA",
        "URNS"
      ],
      "description": "Service level code; optional for this version."
    },
    "requested_execution_date": {
      "type": "string",
      "format": "date",
      "description": "Requested execution date, 'YYYY-MM-DD' (a full datetime is truncated to its date part)."
    },
    "debtor_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 70,
      "description": "Debtor name"
    },
    "debtor_account_IBAN": {
      "type": "string",
      "pattern": "^[A-Z]{2}[0-9]{2}[A-Z0-9]+$",
      "minLength": 15,
      "maxLength": 34,
      "description": "Debtor IBAN"
    },
    "debtor_agent_BIC": {
      "type": "string",
      "pattern": "^[A-Z0-9]{6}[A-Z0-9]{2}([A-Z0-9]{3})?$",
      "description": "Debtor BIC"
    },
    "forwarding_agent_BIC": {
      "type": "string",
      "pattern": "^[A-Z0-9]{6}[A-Z0-9]{2}([A-Z0-9]{3})?$",
      "description": "Forwarding agent BIC"
    },
    "charge_bearer": {
      "type": "string",
      "enum": [
        "SLEV",
        "SHAR",
        "CRED",
        "DEBT"
      ],
      "description": "Charge bearer code; optional, defaults to 'SLEV'."
    },
    "payment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 35,
      "pattern": "^[A-Za-z0-9\\-?:().,'+/\\s]*$",
      "description": "Payment ID"
    },
    "payment_amount": {
      "type": "number",
      "minimum": 0.01,
      "maximum": 999999999.99,
      "description": "Payment amount, max two decimals (the key 'amount' is accepted as an alias)."
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "description": "ISO 4217 currency code, 3 uppercase letters (the key 'payment_currency' is accepted as an alias)."
    },
    "creditor_agent_BIC": {
      "type": "string",
      "pattern": "^[A-Z0-9]{6}[A-Z0-9]{2}([A-Z0-9]{3})?$",
      "description": "Creditor BIC"
    },
    "creditor_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 70,
      "description": "Creditor name"
    },
    "creditor_account_IBAN": {
      "type": "string",
      "pattern": "^[A-Z]{2}[0-9]{2}[A-Z0-9]+$",
      "minLength": 15,
      "maxLength": 34,
      "description": "Creditor IBAN"
    },
    "remittance_information": {
      "type": "string",
      "minLength": 1,
      "maxLength": 140,
      "description": "Remittance information; optional, omitted from the XML when absent."
    }
  },
  "additionalProperties": true
}
