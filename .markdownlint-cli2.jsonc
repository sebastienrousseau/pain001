{
  // Markdown style for the docs-lint job. Kept permissive on length and
  // HTML because the README uses centred HTML headers and the docs use
  // MyST directives; the rules that remain catch real defects.
  "config": {
    "default": true,
    "MD013": false,
    "MD033": false,
    "MD041": false,
    "MD024": { "siblings_only": true },
    "MD029": false,
    "MD036": false,
    "MD040": false,
    "MD046": false,
    "MD049": false,
    "MD050": false
  },
  "ignores": [
    "docs/readme-template.md",
    "node_modules/**",
    ".venv/**",
    "docs/_build/**",
    "htmlcov/**",
    "releases/**",
    "CHANGELOG.md",
    "docs/posts/**",
    "pain001/templates/**",
    "scripts/awesome-list-submissions.md"
  ]
}
