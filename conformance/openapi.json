              "additionalProperties": true,
              "type": "object"
            },
            "title": "Scheme Violations",
            "type": "array"
          },
          "total_rows": {
            "description": "Total number of rows",
            "title": "Total Rows",
            "type": "integer"
          },
          "valid_rows": {
            "default": 0,
            "description": "Number of valid rows",
            "title": "Valid Rows",
            "type": "integer"
          }
        },
        "required": [
          "is_valid",
          "total_rows"
        ],
        "title": "ValidationResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "contact": {
      "name": "Pain001",
      "url": "https://github.com/sebastienrousseau/pain001"
    },
    "description": "RESTful API for ISO 20022 **pain.001** / **pain.008** XML generation and\nvalidation.\n\n* **Versioned** \u2014 all endpoints are served under `/api/v1`; the unversioned\n  `/api/*` paths remain as a backwards-compatible alias.\n* **Authenticated** \u2014 set `PAIN001_API_KEY` to require a\n  `Authorization: Bearer <key>` header (open in local development).\n* **Rate limited** \u2014 set `PAIN001_RATE_LIMIT` (e.g. `100/minute`) to cap\n  requests per client.\n\nInteractive reference: [`/api/reference`](/api/reference) \u00b7\nOpenAPI document: [`/openapi.json`](/openapi.json) \u00b7\nDashboard: [`/api/v1/ui`](/api/v1/ui) (disable with `PAIN001_UI_DISABLED=1`)\n",
    "license": {
      "name": "Apache-2.0",
      "url": "https://www.apache.org/licenses/LICENSE-2.0"
    },
    "title": "Pain001 REST API",
    "version": "conformance-kit-1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/check": {
      "post": {
        "description": "Run the validation ladder on the document in the body.\n\nArgs:\n    request: The document, and the scheme profiles and Schematron\n        preset to add.\n\nReturns:\n    The report, ``passed: false`` when a rung found an error.\n\nRaises:\n    HTTPException: ``422`` when the document cannot be checked.",
        "operationId": "check_api_v1_check_post",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "description": "The document cannot be checked"
          }
        },
