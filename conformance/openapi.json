{
  "components": {
    "schemas": {
      "CheckFindingModel": {
        "description": "One problem one rung found.",
        "properties": {
          "location": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Element path, context, or transaction N",
            "title": "Location"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "rule": {
            "title": "Rule",
            "type": "string"
          },
          "rung": {
            "description": "xsd, mdr, scheme or schematron",
            "title": "Rung",
            "type": "string"
          },
          "severity": {
            "description": "error or warning",
            "title": "Severity",
            "type": "string"
          }
        },
        "required": [
          "rung",
          "rule",
          "severity",
          "message"
        ],
        "title": "CheckFindingModel",
        "type": "object"
      },
      "CheckRequest": {
        "description": "A document to check, with the optional rungs to add.",
        "properties": {
          "schematron": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "A Schematron preset (sepa, fednow, cbpr); not a path",
            "title": "Schematron"
          },
          "scheme": {
            "anyOf": [
              {
                "pattern": "^[a-z0-9-]+(,[a-z0-9-]+)*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Scheme profiles, comma-separated (e.g. sepa-sct)",
            "title": "Scheme"
          },
          "xml": {
            "description": "The pain.001 or pain.008 document as XML text",
            "maxLength": 10485760,
            "minLength": 1,
            "title": "Xml",
            "type": "string"
          }
        },
        "required": [
          "xml"
        ],
        "title": "CheckRequest",
        "type": "object"
      },
      "CheckResponse": {
        "description": "The report: the verdict, the rungs that ran and every finding.",
        "properties": {
          "errors": {
            "title": "Errors",
            "type": "integer"
          },
          "findings": {
            "items": {
              "$ref": "#/components/schemas/CheckFindingModel"
            },
            "title": "Findings",
            "type": "array"
          },
          "message_type": {
            "title": "Message Type",
            "type": "string"
          },
          "passed": {
            "title": "Passed",
            "type": "boolean"
          },
          "rungs": {
            "items": {
              "type": "string"
            },
            "title": "Rungs",
            "type": "array"
          },
          "warnings": {
            "title": "Warnings",
            "type": "integer"
          }
        },
        "required": [
          "message_type",
          "passed",
          "errors",
          "warnings",
          "rungs",
          "findings"
        ],
        "title": "CheckResponse",
        "type": "object"
      },
      "DataSourceType": {
        "description": "Supported data source types.",
        "enum": [
          "csv",
          "sqlite",
          "json",
          "jsonl",
          "parquet"
        ],
        "title": "DataSourceType",
        "type": "string"
      },
      "FaceInfo": {
        "description": "One face: its name, its target and the bindings it accepts.",
        "properties": {
          "bindings": {
            "description": "Binding keys the face accepts; any other is refused",
            "items": {
              "type": "string"
            },
            "title": "Bindings",
            "type": "array"
          },
          "description": {
            "description": "The target standard",
            "title": "Description",
            "type": "string"
          },
          "name": {
            "description": "Face name, used in the path",
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "description",
          "bindings"
        ],
        "title": "FaceInfo",
        "type": "object"
      },
      "FaceRequest": {
        "description": "A pain.001 document to project, with optional private bindings.",
        "properties": {
          "bindings": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "Side inputs the message does not carry (for example a UK Open Banking ConsentId); used for this response only",
            "title": "Bindings"
          },
          "version": {
            "anyOf": [
              {
                "pattern": "^pain\\.001\\.001\\.\\d{2}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The pain.001 edition; detected from the namespace if omitted",
            "title": "Version"
          },
          "xml": {
            "description": "The pain.001 document as XML text",
            "maxLength": 10485760,
            "minLength": 1,
            "title": "Xml",
            "type": "string"
          }
        },
        "required": [
          "xml"
        ],
        "title": "FaceRequest",
        "type": "object"
      },
      "FaceResponse": {
        "description": "The target payload and its loss report.",
        "properties": {
          "face": {
            "title": "Face",
            "type": "string"
          },
          "loss_report": {
            "$ref": "#/components/schemas/LossReportModel"
          },
          "payload": {
            "additionalProperties": true,
            "description": "The body in the target's shape",
            "title": "Payload",
            "type": "object"
          },
          "version": {
            "description": "The source pain.001 edition",
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "face",
          "version",
          "payload",
          "loss_report"
        ],
        "title": "FaceResponse",
        "type": "object"
      },
      "GenerateXMLRequest": {
        "description": "Request model for XML generation.",
        "examples": [
          {
            "data_source": "csv",
            "file_path": "payments.csv",
            "message_type": "pain.001.001.03",
            "output_dir": ".",
            "validate_only": false
          }
        ],
        "properties": {
          "data_source": {
            "$ref": "#/components/schemas/DataSourceType",
            "description": "Type of data source"
          },
          "file_path": {
            "description": "Path to the data file",
            "title": "File Path",
            "type": "string"
          },
          "identifier_checks": {
            "default": true,
            "description": "Check every IBAN (mod-97, country length) and BIC (ISO 9362) column; false skips those checks",
            "title": "Identifier Checks",
            "type": "boolean"
          },
          "message_type": {
            "$ref": "#/components/schemas/MessageType",
            "default": "pain.001.001.03",
            "description": "ISO 20022 message type"
          },
          "output_dir": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Output directory for generated XML",
            "title": "Output Dir"
          },
          "rules": {
            "anyOf": [
              {
                "maxLength": 65536,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Inline YAML CEL policy enforced before generation; requires pain001[rules].",
            "title": "Rules"
          },
          "scheme": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Payment-scheme rulebook to enforce before generating (e.g. 'sepa-sct', 'sepa-sdd', 'sepa-b2b', 'sepa-inst', 'xborder-ct', 'anti-duplicate'); comma-separate names to run several",
            "title": "Scheme"
          },
          "table_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Table name for SQLite sources",
            "title": "Table Name"
          },
          "validate_only": {
            "default": false,
            "description": "Only validate, don't generate XML",
            "title": "Validate Only",
            "type": "boolean"
          }
        },
        "required": [
          "data_source",
          "file_path"
        ],
        "title": "GenerateXMLRequest",
        "type": "object"
      },
      "GenerateXMLResponse": {
        "description": "Response model for XML generation.",
        "properties": {
          "file_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Path to generated XML",
            "title": "File Path"
          },
          "message": {
            "description": "Result message",
            "title": "Message",
            "type": "string"
          },
          "scheme_violations": {
            "description": "Scheme-rulebook violations if scheme validation failed",
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Scheme Violations",
            "type": "array"
          },
          "success": {
            "description": "Whether generation succeeded",
            "title": "Success",
            "type": "boolean"
          },
          "validation_errors": {
            "description": "Validation errors if validation failed",
            "items": {
              "$ref": "#/components/schemas/RowError"
            },
            "title": "Validation Errors",
            "type": "array"
          }
        },
        "required": [
          "success",
          "message"
        ],
        "title": "GenerateXMLResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "description": "Response model for health check.",
        "properties": {
          "message": {
            "description": "Health check message",
            "title": "Message",
            "type": "string"
          },
          "status": {
            "description": "Service status",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "description": "API version",
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version",
          "message"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "JobStatusResponse": {
        "description": "Response model for job status.",
        "properties": {
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Error message if failed",
            "title": "Error"
          },
          "job_id": {
            "description": "Unique job identifier",
            "title": "Job Id",
            "type": "string"
          },
          "message": {
            "description": "Status message",
            "title": "Message",
            "type": "string"
          },
          "progress_percent": {
            "default": 0,
            "description": "Progress percentage (0-100)",
            "title": "Progress Percent",
            "type": "integer"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/GenerateXMLResponse"
              },
              {
                "type": "null"
              }
            ],
            "description": "Result when status is success"
          },
          "status": {
            "description": "Current job status (pending, processing, success, failed, cancelled)",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "job_id",
          "status",
          "message"
        ],
        "title": "JobStatusResponse",
        "type": "object"
      },
      "LossReportModel": {
        "description": "What the projection carried and what it did not, by indexed path.",
        "properties": {
          "face": {
            "title": "Face",
            "type": "string"
          },
          "is_lossless": {
            "title": "Is Lossless",
            "type": "boolean"
          },
          "loss_ratio": {
            "description": "Share of source leaves not carried",
            "title": "Loss Ratio",
            "type": "number"
          },
          "mapped_count": {
            "title": "Mapped Count",
            "type": "integer"
          },
          "mapped_paths": {
            "items": {
              "type": "string"
            },
            "title": "Mapped Paths",
            "type": "array"
          },
          "total_source_elements": {
            "title": "Total Source Elements",
            "type": "integer"
          },
          "unmapped_count": {
            "title": "Unmapped Count",
            "type": "integer"
          },
          "unmapped_paths": {
            "items": {
              "type": "string"
            },
            "title": "Unmapped Paths",
            "type": "array"
          }
        },
        "required": [
          "face",
          "total_source_elements",
          "mapped_count",
          "unmapped_count",
          "is_lossless",
          "loss_ratio",
          "mapped_paths",
          "unmapped_paths"
        ],
        "title": "LossReportModel",
        "type": "object"
      },
      "MessageType": {
        "description": "Supported ISO 20022 message types.",
        "enum": [
          "pain.001.001.03",
          "pain.001.001.04",
          "pain.001.001.05",
          "pain.001.001.06",
          "pain.001.001.07",
          "pain.001.001.08",
          "pain.001.001.09",
          "pain.001.001.10",
          "pain.001.001.11",
          "pain.001.001.12",
          "pain.001.001.13",
          "pain.008.001.02",
          "pain.008.001.08"
        ],
        "title": "MessageType",
        "type": "string"
      },
      "RowError": {
        "description": "One row-level validation error.\n\nNamed ``RowError`` in the OpenAPI document: FastAPI publishes its own\nrequest-validation error as ``ValidationError``, which replaced this\nmodel's schema under the old name. ``ValidationError`` stays as an\nalias for Python callers.",
        "properties": {
          "field": {
            "description": "Field name or JSON path",
            "title": "Field",
            "type": "string"
          },
          "message": {
            "description": "Error message",
            "title": "Message",
            "type": "string"
          },
          "value": {
            "anyOf": [
              {},
              {
                "type": "null"
              }
            ],
            "description": "The invalid value",
            "title": "Value"
          }
        },
        "required": [
          "field",
          "message"
        ],
        "title": "RowError",
        "type": "object"
      },
      "UiFilePayload": {
        "description": "An uploaded payment file, as the dashboard sends it.\n\nThe browser reads the dropped file and posts its text; the server\nparses it in memory, so nothing the user uploads touches the disk.",
        "examples": [
          {
            "content": "id,date,nb_of_txs,...",
            "filename": "payments.csv",
            "message_type": "pain.001.001.03",
            "scheme": "sepa-sct,anti-duplicate"
          }
        ],
        "properties": {
          "content": {
            "description": "The file's text (UTF-8)",
            "title": "Content",
            "type": "string"
          },
          "filename": {
            "description": "Name the browser reported; only the suffix (.csv, .json, .jsonl) is used to pick a parser",
            "maxLength": 255,
            "minLength": 1,
            "title": "Filename",
            "type": "string"
          },
          "message_type": {
            "$ref": "#/components/schemas/MessageType",
            "default": "pain.001.001.03",
            "description": "ISO 20022 message type"
          },
          "scheme": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Payment-scheme rulebook(s) to enforce (e.g. 'sepa-sct', 'anti-duplicate'); comma-separate names to run several",
            "title": "Scheme"
          }
        },
        "required": [
          "filename",
          "content"
        ],
        "title": "UiFilePayload",
        "type": "object"
      },
      "UiGenerateResponse": {
        "description": "Result of generating XML from an uploaded file.\n\nOn success the XML document travels inline so the browser can offer\nit as a download; on failure the blocking findings are attached.",
        "properties": {
          "filename": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Suggested download name for the XML",
            "title": "Filename"
          },
          "message": {
            "description": "Result message",
            "title": "Message",
            "type": "string"
          },
          "scheme_violations": {
            "description": "Scheme-rulebook violations if scheme validation failed",
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Scheme Violations",
            "type": "array"
          },
          "success": {
            "description": "Whether generation succeeded",
            "title": "Success",
            "type": "boolean"
          },
          "validation_errors": {
            "description": "Validation errors if validation failed",
            "items": {
              "$ref": "#/components/schemas/RowError"
            },
            "title": "Validation Errors",
            "type": "array"
          },
          "xml": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The generated XML document",
            "title": "Xml"
          }
        },
        "required": [
          "success",
          "message"
        ],
        "title": "UiGenerateResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "ValidationRequest": {
        "description": "Request model for data validation.",
        "examples": [
          {
            "data_source": "csv",
            "file_path": "payments.csv",
            "message_type": "pain.001.001.03",
            "scheme": "sepa-sct"
          }
        ],
        "properties": {
          "data_source": {
            "$ref": "#/components/schemas/DataSourceType",
            "description": "Type of data source (csv, sqlite, json, etc.)"
          },
          "file_path": {
            "description": "Path to the data file",
            "title": "File Path",
            "type": "string"
          },
          "identifier_checks": {
            "default": true,
            "description": "Check every IBAN (mod-97, country length) and BIC (ISO 9362) column; false skips those checks",
            "title": "Identifier Checks",
            "type": "boolean"
          },
          "message_type": {
            "$ref": "#/components/schemas/MessageType",
            "default": "pain.001.001.03",
            "description": "ISO 20022 message type"
          },
          "rules": {
            "anyOf": [
              {
                "maxLength": 65536,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Inline YAML CEL policy; requires pain001[rules]. Never a server-side file path.",
            "title": "Rules"
          },
          "scheme": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Payment-scheme rulebook to validate against (e.g. 'sepa-sct', 'sepa-sdd', 'sepa-b2b', 'sepa-inst', 'xborder-ct', 'anti-duplicate'); comma-separate names to run several",
            "title": "Scheme"
          },
          "table_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Table name for SQLite sources",
            "title": "Table Name"
          }
        },
        "required": [
          "data_source",
          "file_path"
        ],
        "title": "ValidationRequest",
        "type": "object"
      },
      "ValidationResponse": {
        "description": "Response model for validation results.",
        "properties": {
          "errors": {
            "description": "List of validation errors",
            "items": {
              "$ref": "#/components/schemas/RowError"
            },
            "title": "Errors",
            "type": "array"
          },
          "invalid_rows": {
            "default": 0,
            "description": "Number of invalid rows",
            "title": "Invalid Rows",
            "type": "integer"
          },
          "is_valid": {
            "description": "Whether data is valid",
            "title": "Is Valid",
            "type": "boolean"
          },
          "scheme_violations": {
            "description": "Scheme-rulebook violations (when a scheme is given)",
