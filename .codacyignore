# Codacy Ignore File for Pain001
# Excludes files with false positives or legitimate test patterns
# Format: Same as .gitignore (supports wildcards, directories, specific files)

# ============================================================================
# TEST FILES - Legitimate patterns that Codacy flags incorrectly
# ============================================================================

# JSON/Parquet/CSV loader tests: Fixture redefinition is pytest standard pattern
tests/test_json_loader.py
tests/test_parquet_loader.py
tests/test_data_loader.py
tests/test_data_loader_streaming.py

# Integration/Streaming tests: Import outside toplevel is intentional for test isolation
tests/test_integration_matrix.py
tests/test_streaming_loaders.py
tests/test_backward_compatibility.py

# Coverage tests: Import inside functions for coverage measurement
tests/test_additional_coverage.py
tests/test_cli_coverage.py

# API tests: Import pytest inside functions for optional dependency handling
tests/test_api.py

# XML generation tests: XML ElementTree usage for validation (not parsing untrusted data)
tests/test_xml_to_string.py
tests/test_xml_string_generation.py
tests/test_xml_generation.py

# ISO 20022 version tests: et.parse() used for validation ONLY (trusted test data)
tests/test_pain001_v03.py
tests/test_pain001_v04.py
tests/test_pain001_v05.py
tests/test_pain001_v06.py
tests/test_pain001_v07.py
tests/test_pain001_v08.py
tests/test_pain001_v09.py
tests/test_pain001_v10.py
tests/test_pain001_v11.py

# JSON logging tests: Import inside functions for test isolation
tests/test_json_logging.py

# Schema validator tests: Too many public methods (comprehensive test suite)
tests/test_schema_validator.py

# ============================================================================
# PRODUCTION FILES - Legitimate complexity
# ============================================================================

# Pydantic models: Too few public methods (BaseModel data containers by design)
pain001/api/models.py

# Job manager: Legitimate complexity for background job orchestration
pain001/api/job_manager.py

# CLI: Legitimate argument parsing complexity
pain001/cli/cli.py

# Data loader: Multi-format support requires branching logic
pain001/data/loader.py

# Logging schema: Comprehensive telemetry requires many attributes/arguments
pain001/logging_schema.py

# FastAPI app: Async endpoint complexity
pain001/api/app.py

# ============================================================================
